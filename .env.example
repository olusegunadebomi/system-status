
# Core API base URL. TODO: fill in the production API host.
GOLVIA_API_BASE_URL=
# Main web app (used for the Web App, Support and Deep links probes)
GOLVIA_WEB_URL=https://golvia.app
# SockJS endpoint for messaging. Defaults to ${GOLVIA_API_BASE_URL}/ws
GOLVIA_WS_URL=
# Health endpoint path on the API, e.g. /actuator/health. TODO(backend): confirm.
GOLVIA_HEALTH_PATH=
# Public 1-byte object for the storage probe. TODO(backend): upload status-probe.txt first.
GOLVIA_S3_PROBE_URL=https://<bucket>.s3.<region>.amazonaws.com/status-probe.txt
# SECRET: Bearer token for /api/v1/system-status/* (incidents, maintenance, uptime).
# Real value goes in .env only — never commit it.
GOLVIA_STATUS_API_TOKEN=

─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://status.golvia.app
NEXT_PUBLIC_APP_URL=https://golvia.app
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=

# ── Probe tuning ───────────────────────────────────────────────────────────────
PROBE_TIMEOUT_MS=5000
PROBE_DEGRADED_MS=2000
PROBE_CACHE_SECONDS=30

# ── Sample data ────────────────────────────────────────────────────────────────
# Sample incidents/maintenance/uptime are always used outside production.
# Set STATUS_MOCK=1 to use them in a production build (previews only).
STATUS_MOCK=
# With mock data, force a page state: operational | degraded | partial | major | maintenance
STATUS_MOCK_SCENARIO=
